<Window x:Class="ThoughtNote.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ThoughtNote.Core;assembly=ThoughtNote.Core"
        Title="ThoughtNote" Height="600" Width="900">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Tree -->
        <TreeView Name="NodeTree"
                  ItemsSource="{Binding nodes}"
                  SelectedItemChanged="NodeTree_SelectedItemChanged"
                  KeyDown="NodeTree_KeyDown">
                <TreeView.Resources>

                <!-- Node表示 -->
                <HierarchicalDataTemplate DataType="{x:Type core:Node}"
                                          ItemsSource="{Binding Children}">

                    <TextBlock Text="{Binding Title}" />

                </HierarchicalDataTemplate>

            </TreeView.Resources>

        </TreeView>

        <!-- 右側編集 -->
        <StackPanel Grid.Column="1" Margin="10">

            <TextBlock Text="Body" Margin="0,10,0,0"/>
            <TextBox Name="BodyBox"
                     AcceptsReturn="True"
                     Height="400"
                     TextWrapping="Wrap"
                     KeyDown="BodyBox_KeyDown"/>

        </StackPanel>

    </Grid>
</Window>